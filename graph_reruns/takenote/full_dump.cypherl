CREATE INDEX ON :`Library`(`name`);
CREATE CONSTRAINT ON (u:`Project`) ASSERT u.`projectId` IS UNIQUE;
CREATE CONSTRAINT ON (u:`File`) ASSERT u.`filePath` IS UNIQUE;
CREATE CONSTRAINT ON (u:`Function_Component`) ASSERT u.`uid` IS UNIQUE;
CREATE CONSTRAINT ON (u:`Class_Component`) ASSERT u.`uid` IS UNIQUE;
CREATE CONSTRAINT ON (u:`Library_Hook`) ASSERT u.`uid` IS UNIQUE;
CREATE CONSTRAINT ON (u:`Custom_Hook`) ASSERT u.`uid` IS UNIQUE;
CREATE CONSTRAINT ON (u:`Prop`) ASSERT u.`uid` IS UNIQUE;
CREATE CONSTRAINT ON (u:`State_Variable`) ASSERT u.`uid` IS UNIQUE;
CREATE CONSTRAINT ON (u:`Context`) ASSERT u.`uid` IS UNIQUE;
CREATE CONSTRAINT ON (u:`EventHandler`) ASSERT u.`uid` IS UNIQUE;
CREATE CONSTRAINT ON (u:`Library`) ASSERT u.`name` IS UNIQUE;
