### Example 6
Input:
import React, { useState, useEffect, useContext } from 'react';
import { useParams, useNavigate } from 'react-router-dom';
import { CartContext } from '../context/CartContext';
import useLocalStorage from './hooks/useLocalStorage';

function ProductDetail() {
  const { id } = useParams();
  const navigate = useNavigate();
  const { addToCart } = useContext(CartContext);
  const [product, setProduct] = useState(null);
  const [savedItems, setSavedItems] = useLocalStorage('saved', []);

  useEffect(() => {
    fetch(`/api/products/${id}`).then(r => r.json()).then(setProduct);
  }, [id]);

  return (
    <div>
      <h1>{product?.name}</h1>
      <button onClick={() => addToCart(product)}>Add to Cart</button>
      <button onClick={() => navigate(-1)}>Back</button>
    </div>
  );
}

export default ProductDetail;

Output:
{
  "components": [
    {
      "name": "ProductDetail",
      "syntax": "function",
      "usesHooks": true,
      "hookDetails": [
        { "name": "useParams", "category": "library", "source": "react-router-dom" },
        { "name": "useNavigate", "category": "library", "source": "react-router-dom" },
        { "name": "useContext", "category": "library", "source": "react" },
        { "name": "useState", "category": "library", "source": "react" },
        { "name": "useLocalStorage", "category": "custom", "source": "./hooks/useLocalStorage" },
        { "name": "useEffect", "category": "library", "source": "react" }
      ],
      "returnsJSX": true,
      "exportType": "default"
    }
  ]
}

