### Example 6
Input:
import React, { createContext, useState, useContext } from 'react';

const SidebarContext = createContext({ isOpen: false, toggle: () => {} });

function SidebarProvider({ children }) {
  const [isOpen, setIsOpen] = useState(false);
  const toggle = () => setIsOpen(prev => !prev);

  return (
    <SidebarContext.Provider value={{ isOpen, toggle }}>
      {children}
    </SidebarContext.Provider>
  );
}

function SidebarToggle() {
  const { toggle } = useContext(SidebarContext);
  return <button onClick={toggle}>Toggle Sidebar</button>;
}

function SidebarPanel() {
  const { isOpen } = useContext(SidebarContext);
  if (!isOpen) return null;
  return <aside className="sidebar">Sidebar Content</aside>;
}

export { SidebarContext, SidebarProvider, SidebarToggle, SidebarPanel };

Output:
{
  "contextProviders": [
    {
      "componentName": "SidebarProvider",
      "contextName": "SidebarContext",
      "contextSource": "same_file",
      "valueExpression": "{ isOpen, toggle }"
    }
  ],
  "contextConsumers": [
    {
      "consumerName": "SidebarToggle",
      "consumerType": "function_component",
      "contextName": "SidebarContext",
      "contextSource": "same_file",
      "consumptionMethod": "useContext"
    },
    {
      "consumerName": "SidebarPanel",
      "consumerType": "function_component",
      "contextName": "SidebarContext",
      "contextSource": "same_file",
      "consumptionMethod": "useContext"
    }
  ]
}

Note: One provider and two consumers, all in the same file referencing the same context.

