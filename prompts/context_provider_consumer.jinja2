### Example 3
Input:
import React, { useContext, useState, useCallback } from 'react';
import { CartContext } from './CartContext';

function useCart() {
  const { items, dispatch } = useContext(CartContext);

  const addItem = useCallback((product) => {
    dispatch({ type: 'ADD_ITEM', payload: product });
  }, [dispatch]);

  const removeItem = useCallback((productId) => {
    dispatch({ type: 'REMOVE_ITEM', payload: productId });
  }, [dispatch]);

  const totalPrice = items.reduce((sum, item) => sum + item.price * item.qty, 0);

  return { items, addItem, removeItem, totalPrice };
}

export default useCart;

Output:
{
  "contextProviders": [],
  "contextConsumers": [
    {
      "consumerName": "useCart",
      "consumerType": "custom_hook",
      "contextName": "CartContext",
      "contextSource": "./CartContext",
      "consumptionMethod": "useContext"
    }
  ]
}

Note: `useCart` is a custom hook (not a component) that consumes `CartContext`.

