### Example 4
Input:
import { useState, useCallback } from 'react';

function useCart() {
  const [items, setItems] = useState([]);
  const [total, setTotal] = useState(0);

  const addItem = useCallback((item) => {
    setItems(prev => [...prev, item]);
    setTotal(prev => prev + item.price);
  }, []);

  return { items, total, addItem };
}

export default useCart;

Output:
{
  "stateVariables": [
    {
      "name": "items",
      "setterName": "setItems",
      "type": "array",
      "defaultValue": "[]",
      "componentName": "useCart",
      "declarationPattern": "useState"
    },
    {
      "name": "total",
      "setterName": "setTotal",
      "type": "number",
      "defaultValue": "0",
      "componentName": "useCart",
      "declarationPattern": "useState"
    }
  ]
}

Note: `useCart` is a custom hook, not a component. State declared inside custom hooks is extracted with the same structure, using the hook name as `componentName`.

