### Example 3
Input:
import React, { useReducer } from 'react';

const initialState = { count: 0, step: 1 };

function reducer(state, action) {
  switch (action.type) {
    case 'increment':
      return { ...state, count: state.count + state.step };
    case 'setStep':
      return { ...state, step: action.payload };
    default:
      return state;
  }
}

function StepCounter() {
  const [state, dispatch] = useReducer(reducer, initialState);

  return (
    <div>
      <p>Count: {state.count}</p>
      <button onClick={() => dispatch({ type: 'increment' })}>+{state.step}</button>
    </div>
  );
}

export default StepCounter;

Output:
{
  "stateVariables": [
    {
      "name": "state",
      "setterName": "dispatch",
      "type": "object",
      "defaultValue": "initialState",
      "componentName": "StepCounter",
      "declarationPattern": "useReducer"
    }
  ]
}

Note: The default value is the variable name `initialState` as written in the code, not its resolved value.

