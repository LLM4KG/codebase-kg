### Example 1
Input:
import React, { useState } from 'react';

function Counter() {
  const [count, setCount] = useState(0);
  return (
    <div>
      <p>{count}</p>
      <button onClick={() => setCount(count + 1)}>+</button>
    </div>
  );
}

export default Counter;

Output:
{
  "stateVariables": [
    {
      "name": "count",
      "setterName": "setCount",
      "type": "number",
      "defaultValue": "0",
      "componentName": "Counter",
      "declarationPattern": "useState"
    }
  ]
}

