### Example 5
Input:
import { useState, useCallback } from 'react';

export const useToggle = (initial = false) => {
  const [value, setValue] = useState(initial);
  const toggle = useCallback(() => setValue(v => !v), []);
  return [value, toggle];
};

function useDebouncedValue({ value, delay }) {
  const [debounced, setDebounced] = useState(value);
  return debounced;
}

Output:
{
  "customHooks": [
    {
      "name": "useToggle",
      "syntax": "arrow",
      "exportType": "named",
      "parameters": ["initial"],
      "returnShape": "array"
    },
    {
      "name": "useDebouncedValue",
      "syntax": "function",
      "exportType": "none",
      "parameters": ["value", "delay"],
      "returnShape": "primitive"
    }
  ]
}

Note: destructured parameters are listed by their property names. `useDebouncedValue` is not exported, so `exportType` is "none".

