### Example 5
Input:
import React, { createContext, useReducer } from 'react';

const initialState = { notifications: [], unreadCount: 0 };

const NotificationContext = createContext(initialState);

function notificationReducer(state, action) {
  switch (action.type) {
    case 'ADD':
      return {
        notifications: [...state.notifications, action.payload],
        unreadCount: state.unreadCount + 1,
      };
    case 'MARK_READ':
      return { ...state, unreadCount: 0 };
    default:
      return state;
  }
}

const NotificationProvider = ({ children }) => {
  const [state, dispatch] = useReducer(notificationReducer, initialState);

  return (
    <NotificationContext.Provider value={{ state, dispatch }}>
      {children}
    </NotificationContext.Provider>
  );
};

export { NotificationContext, NotificationProvider };

Output:
{
  "contexts": [
    {
      "name": "NotificationContext",
      "defaultValue": "initialState",
      "exportType": "named"
    }
  ]
}

Note: The default value is the variable name `initialState` as written in the code. The provider component and reducer are not part of the context definition extraction.

