import React, { lazy, Suspense } from 'react';
import { Routes, Route } from 'react-router-dom';
import Layout from './components/Layout';
import RequireAuth from './components/RequireAuth';
import Home from './pages/Home';

const Profile = lazy(() => import('./pages/Profile'));
const Settings = lazy(() => import('./pages/Settings'));
const Billing = lazy(() => import('./pages/Billing'));

function App() {
  return (
    <Suspense fallback={<div>Loading...</div>}>
      <Routes>
        <Route path="/" element={<Home />} />
        <Route element={<RequireAuth />}>
          <Route element={<Layout />}>
            <Route path="/profile" element={<Profile />} />
            <Route path="/settings" element={<Settings />}>
              <Route path="billing" element={<Billing />} />
            </Route>
          </Route>
        </Route>
      </Routes>
    </Suspense>
  );
}

export default App;

Output:
{
  "routeDefinitions": [
    {
      "routingComponent": "App",
      "targetComponent": "Home",
      "importSource": "./pages/Home",
      "path": "/",
      "isNested": false,
      "isLazy": false,
      "isProtected": false
    },
    {
      "routingComponent": "App",
      "targetComponent": "Profile",
      "importSource": "./pages/Profile",
      "path": "/profile",
      "isNested": true,
      "isLazy": true,
      "isProtected": true
    },
    {
      "routingComponent": "App",
      "targetComponent": "Settings",
      "importSource": "./pages/Settings",
      "path": "/settings",
      "isNested": true,
      "isLazy": true,
      "isProtected": true
    },
    {
      "routingComponent": "App",
      "targetComponent": "Billing",
      "importSource": "./pages/Billing",
      "path": "/settings/billing",
      "isNested": true,
      "isLazy": true,
      "isProtected": true
    }
  ]
}

Note: This combines all three boolean flags. `RequireAuth` is a pathless layout route acting as an auth guard (`isProtected: true`). `Layout` is another pathless layout route. `Profile`, `Settings`, and `Billing` are nested inside both. `Billing` composes the full path `/settings/billing`. All lazy-loaded components have `isLazy: true`. `RequireAuth` and `Layout` are NOT listed as route targets since they are pathless layout/guard wrappers — only the actual page components are targets.

