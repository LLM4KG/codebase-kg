### Example 4
Input:
import React from 'react';

const Button = ({ label, onClick }) => {
  return <button onClick={onClick}>{label}</button>;
};

const Alert = ({ message, onDismiss }) => {
  return (
    <div className="alert">
      <span>{message}</span>
      <Button label="Dismiss" onClick={onDismiss} />
    </div>
  );
};

function Card({ title, children }) {
  return (
    <div className="card">
      <h2>{title}</h2>
      {children}
    </div>
  );
}

function Page() {
  const handleDismiss = () => console.log('dismissed');

  return (
    <Card title="Notifications">
      <Alert message="New update available" onDismiss={handleDismiss} />
    </Card>
  );
}

export default Page;

Output:
{
  "componentUsages": [
    {
      "parentComponent": "Alert",
      "childComponent": "Button",
      "importSource": "same_file",
      "usage": "element",
      "propsPassed": [
        { "propName": "label", "valueExpression": "\"Dismiss\"" },
        { "propName": "onClick", "valueExpression": "onDismiss" }
      ]
    },
    {
      "parentComponent": "Page",
      "childComponent": "Card",
      "importSource": "same_file",
      "usage": "element",
      "propsPassed": [
        { "propName": "title", "valueExpression": "\"Notifications\"" }
      ]
    },
    {
      "parentComponent": "Page",
      "childComponent": "Alert",
      "importSource": "same_file",
      "usage": "element",
      "propsPassed": [
        { "propName": "message", "valueExpression": "\"New update available\"" },
        { "propName": "onDismiss", "valueExpression": "handleDismiss" }
      ]
    }
  ]
}

Note: `Button` is defined in the same file as `Alert`, so `importSource` is `"same_file"`. `Card` receives `children` as nested JSX — this is not listed in `propsPassed` since it is not an explicit attribute.

