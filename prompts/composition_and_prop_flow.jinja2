Input:
import React from 'react';
import Header from './components/Header';
import Footer from './components/Footer';

function App() {
  return (
    <div>
      <Header title="My App" />
      <main>Content</main>
      <Footer year={2024} />
    </div>
  );
}

export default App;

Output:
{
  "componentUsages": [
    {
      "parentComponent": "App",
      "childComponent": "Header",
      "importSource": "./components/Header",
      "usage": "element",
      "propsPassed": [
        { "propName": "title", "valueExpression": "\"My App\"" }
      ]
    },
    {
      "parentComponent": "App",
      "childComponent": "Footer",
      "importSource": "./components/Footer",
      "usage": "element",
      "propsPassed": [
        { "propName": "year", "valueExpression": "2024" }
      ]
