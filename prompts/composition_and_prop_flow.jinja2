### Example 5
Input:
import React, { Component } from 'react';
import UserAvatar from './UserAvatar';
import UserInfo from './UserInfo';

class UserProfile extends Component {
  render() {
    const { user, settings } = this.props;
    return (
      <div className="profile">
        <UserAvatar
          src={user.avatarUrl}
          size="large"
          alt={user.name}
        />
        <UserInfo {...user} isAdmin={settings.isAdmin} />
      </div>
    );
  }
}

export default UserProfile;

Output:
{
  "componentUsages": [
    {
      "parentComponent": "UserProfile",
      "childComponent": "UserAvatar",
      "importSource": "./UserAvatar",
      "usage": "element",
      "propsPassed": [
        { "propName": "src", "valueExpression": "user.avatarUrl" },
        { "propName": "size", "valueExpression": "\"large\"" },
        { "propName": "alt", "valueExpression": "user.name" }
      ]
    },
    {
      "parentComponent": "UserProfile",
      "childComponent": "UserInfo",
      "importSource": "./UserInfo",
      "usage": "element",
      "propsPassed": [
        { "propName": "...user", "valueExpression": "{...user}" },
        { "propName": "isAdmin", "valueExpression": "settings.isAdmin" }
      ]
    }
  ]
}

Note: The spread `{...user}` is captured with the `propName` set to `"...user"` to indicate that individual prop names from the spread are not statically known.

