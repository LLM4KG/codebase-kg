### Example 2
Input:
import React, { useState } from 'react';
import ProductCard from './ProductCard';

function ProductList({ products, onAddToCart }) {
  const [sortBy, setSortBy] = useState('name');

  const sorted = [...products].sort((a, b) => a[sortBy].localeCompare(b[sortBy]));

  return (
    <div className="product-list">
      {sorted.map(product => (
        <ProductCard
          key={product.id}
          product={product}
          onAddToCart={onAddToCart}
          isFeatured={product.featured}
        />
      ))}
    </div>
  );
}

export default ProductList;

Output:
{
  "componentUsages": [
    {
      "parentComponent": "ProductList",
      "childComponent": "ProductCard",
      "importSource": "./ProductCard",
      "usage": "element",
      "propsPassed": [
        { "propName": "product", "valueExpression": "product" },
        { "propName": "onAddToCart", "valueExpression": "onAddToCart" },
        { "propName": "isFeatured", "valueExpression": "product.featured" }
      ]
    }
  ]
}

Note: `key` is excluded as it is a React pseudo-prop, not a component prop.

