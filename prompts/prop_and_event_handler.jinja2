### Example 3
Input:
import React, { Component } from 'react';

class Counter extends Component {
  constructor(props) {
    super(props);
    this.state = { count: this.props.initialCount || 0 };
    this.handleIncrement = this.handleIncrement.bind(this);
  }

  handleIncrement() {
    this.setState(prev => ({ count: prev.count + 1 }));
    if (this.props.onChange) {
      this.props.onChange(this.state.count + 1);
    }
  }

  handleReset = () => {
    this.setState({ count: 0 });
  };

  render() {
    return (
      <div>
        <span>{this.state.count}</span>
        <button onClick={this.handleIncrement}>+</button>
        <button onClick={this.handleReset}>Reset</button>
      </div>
    );
  }
}

export default Counter;

Output:
{
  "props": [
    { "name": "initialCount", "componentName": "Counter", "type": "unknown", "isRequired": null },
    { "name": "onChange", "componentName": "Counter", "type": "function", "isRequired": null }
  ],
  "eventHandlers": [
    { "name": "handleIncrement", "eventType": "onClick", "componentName": "Counter", "isInline": false },
    { "name": "handleReset", "eventType": "onClick", "componentName": "Counter", "isInline": false }
  ]
}

Note: `onChange` is detected as a prop because it is accessed via `this.props.onChange`. Its type is inferred as "function" because it is invoked as a callback.

