### Example 5
Input:
import React from 'react';

function SearchBar(props) {
  const handleKeyDown = (e) => {
    if (e.key === 'Enter') {
      props.onSearch(props.query);
    }
  };

  return (
    <input
      type="text"
      value={props.query}
      placeholder={props.placeholder}
      onChange={props.onQueryChange}
      onKeyDown={handleKeyDown}
    />
  );
}

function EmptyState() {
  return <p>No results found.</p>;
}

export { SearchBar, EmptyState };

Output:
{
  "props": [
    { "name": "onSearch", "componentName": "SearchBar", "type": "function", "isRequired": null },
    { "name": "query", "componentName": "SearchBar", "type": "unknown", "isRequired": null },
    { "name": "placeholder", "componentName": "SearchBar", "type": "unknown", "isRequired": null },
    { "name": "onQueryChange", "componentName": "SearchBar", "type": "function", "isRequired": null }
  ],
  "eventHandlers": [
    { "name": "onQueryChange", "eventType": "onChange", "componentName": "SearchBar", "isInline": false },
    { "name": "handleKeyDown", "eventType": "onKeyDown", "componentName": "SearchBar", "isInline": false }
  ]
}

Note: `onQueryChange` appears as both a prop (accepted by SearchBar) and an event handler (bound to `onChange` on the input). This is correct — it is a callback prop that also serves as an event handler in this component's JSX. `EmptyState` has no props and no event handlers, so it does not appear in either array.

