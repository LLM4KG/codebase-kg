### Example 6
Input:
import React from 'react';

class BaseComponent extends React.Component {
  log(message) {
    console.log(message);
  }
}

class FeatureComponent extends BaseComponent {
  constructor(props) {
    super(props);
    this.state = { active: false };
  }

  componentDidMount() {
    this.log("FeatureComponent mounted");
  }

  componentWillUnmount() {
    this.log("FeatureComponent will unmount");
  }

  render() {
    this.log("Rendering FeatureComponent");
    return <div>Feature</div>;
  }
}

export default FeatureComponent;

Output:
{
  "classComponents": [
    {
      "name": "BaseComponent",
      "extendsClass": "React.Component",
      "from": "react",
      "exportType": "none",
      "hasConstructor": false,
      "lifecycleMethods": [],
      "returnsJSX": false
    },
    {
      "name": "FeatureComponent",
      "extendsClass": "BaseComponent",
      "from": "local",
      "exportType": "default",
      "hasConstructor": true,
      "lifecycleMethods": ["componentDidMount", "componentWillUnmount"],
      "returnsJSX": true
    }
  ]
}

Note: BaseComponent has `returnsJSX: false` because it does not define a `render()` method that returns JSX. FeatureComponent extends a local class, so `from` is "local".

