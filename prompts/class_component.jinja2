{
  "classComponents": [
    {
      "name": "Counter",
      "extendsClass": "Component",
      "from": "react",
      "exportType": "default",
      "hasConstructor": true,
      "lifecycleMethods": ["shouldComponentUpdate", "componentDidUpdate"],
      "returnsJSX": true
    }
  ]
}

