### Example 5
Input:
import { useReducer, useCallback } from 'react';
import useLogger from './useLogger';

const formReducer = (state, action) => {
  switch (action.type) {
    case 'SET_FIELD':
      return { ...state, [action.field]: action.value };
    case 'SET_ERRORS':
      return { ...state, errors: action.errors };
    case 'RESET':
      return action.initialState;
    default:
      return state;
  }
};

export const useForm = (initialState, validate) => {
  const [state, dispatch] = useReducer(formReducer, initialState);
  const { log } = useLogger('useForm');

  const setField = useCallback((field, value) => {
    dispatch({ type: 'SET_FIELD', field, value });
    log(`Field updated: ${field}`);
  }, [log]);

  const handleSubmit = useCallback((onSubmit) => {
    const errors = validate ? validate(state) : {};
    if (Object.keys(errors).length > 0) {
      dispatch({ type: 'SET_ERRORS', errors });
    } else {
      onSubmit(state);
    }
  }, [state, validate]);

  const reset = useCallback(() => {
    dispatch({ type: 'RESET', initialState });
  }, [initialState]);

  return { ...state, setField, handleSubmit, reset };
};

Output:
{
  "customHookUsages": [
    {
      "hookName": "useForm",
      "libraryHooks": [
        { "name": "useReducer", "source": "react", "count": 1 },
        { "name": "useCallback", "source": "react", "count": 3 }
      ],
      "customHooks": [
        { "name": "useLogger", "source": "./useLogger" }
      ]
    }
  ]
}

