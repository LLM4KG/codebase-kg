### Example 3
Input:
import { useState, useEffect } from 'react';
import { useNavigate } from 'react-router-dom';
import useAuth from './useAuth';
import useLocalStorage from './useLocalStorage';

function useProtectedResource(resourceUrl) {
  const { user, isLoading: authLoading } = useAuth();
  const navigate = useNavigate();
  const [cachedData, setCachedData] = useLocalStorage(resourceUrl, null);
  const [data, setData] = useState(cachedData);
  const [error, setError] = useState(null);

  useEffect(() => {
    if (!authLoading && !user) {
      navigate('/login');
      return;
    }
    if (user) {
      fetch(resourceUrl, {
        headers: { Authorization: `Bearer ${user.token}` }
      })
        .then(r => r.json())
        .then(d => { setData(d); setCachedData(d); })
        .catch(setError);
    }
  }, [user, authLoading, resourceUrl]);

  return { data, error, isLoading: authLoading || data === null };
}

export default useProtectedResource;

Output:
{
  "customHookUsages": [
    {
      "hookName": "useProtectedResource",
      "libraryHooks": [
        { "name": "useNavigate", "source": "react-router-dom", "count": 1 },
        { "name": "useState", "source": "react", "count": 2 },
        { "name": "useEffect", "source": "react", "count": 1 }
      ],
      "customHooks": [
        { "name": "useAuth", "source": "./useAuth" },
        { "name": "useLocalStorage", "source": "./useLocalStorage" }
      ]
    }
  ]
}

Note: `useAuth` and `useLocalStorage` are custom hooks imported from local files. `useNavigate` is a library hook from `react-router-dom`.

