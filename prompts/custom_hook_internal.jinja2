{
  "customHookUsages": [
    {
      "hookName": "useFilters",
      "libraryHooks": [
        { "name": "useState", "source": "react", "count": 1 },
        { "name": "useCallback", "source": "react", "count": 2 },
        { "name": "useMemo", "source": "react", "count": 1 }
      ],
      "customHooks": []
    },
    {
      "hookName": "usePagination",
      "libraryHooks": [
        { "name": "useState", "source": "react", "count": 1 },
