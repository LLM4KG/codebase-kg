# LLM API Keys (set at least one)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...

# Optional: Override default model via environment
# PIPELINE_LLM__MODEL=anthropic/claude-sonnet-4-5

# Optional: Root directory where cloned repos live (default: ~/repos)
# PIPELINE_EXTRACTION__REPOS_ROOT=~/repos
