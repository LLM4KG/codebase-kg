      "content": "import { useCallback, useEffect, useState } from 'react'\n\nimport { copyToClipboard } from './helpers'\n\ninterface UseCopyToClipboardProps {\n  successMessage: string\n  timeout?: number\n}\n\ninterface UseCopyToClipboardReturn {\n  copiedText: string\n  handleCopy: (text: string) => void\n}\n\nexport const useCopyToClipboard = ({\n  successMessage,\n  timeout = 3000,\n}: UseCopyToClipboardProps): UseCopyToClipboardReturn => {\n  const [copiedText, setCopiedText] = useState<string>('')\n\n  useEffect(() => {\n    if (copiedText === successMessage) {\n      const timer = setTimeout(() => {\n        setCopiedText('')\n      }, timeout)\n\n      return () => clearTimeout(timer)\n    }\n  }, [copiedText, successMessage, timeout])\n\n  const handleCopy = useCallback(\n    (text: string) => {\n      copyToClipboard(text)\n      setCopiedText(successMessage)\n    },\n    [successMessage]\n  )\n\n  return { copiedText, handleCopy }\n}\n\n"
