      "content": "import { useCallback, useEffect, useState } from 'react'\nimport { copyToClipboard } from './helpers'\n\nexport const useCopyToClipboard = (successMessage: string, timeout: number = 3000) => {\n  const [copiedText, setCopiedText] = useState<string>('')\n\n  const handleCopy = useCallback((text: string) => {\n    copyToClipboard(text)\n    setCopiedText(successMessage)\n  }, [successMessage])\n\n  useEffect(() => {\n    if (copiedText === successMessage) {\n      const timer = setTimeout(() => {\n        setCopiedText('')\n      }, timeout)\n\n      return () => clearTimeout(timer)\n    }\n  }, [copiedText, successMessage, timeout])\n\n  return { copiedText, handleCopy }\n}\n\n"
