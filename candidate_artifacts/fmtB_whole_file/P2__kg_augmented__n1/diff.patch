      "content": "import { createSlice, PayloadAction } from '@reduxjs/toolkit'\n\nimport { NoteItem, NotesState } from '@/types'\nimport { Folder } from '@/utils/enums'\nimport { createNote, getNoteTitle } from '@/utils/helpers'\n\nconst initialState: NotesState = {\n  notes: [],\n  activeNoteId: '',\n  selectedNotesIds: [],\n  activeCategoryId: '',\n  activeFolder: Folder.ALL,\n  searchValue: '',\n  error: '',\n  loading: true,\n}\n\nconst noteSlice = createSlice({\n  name: 'note',\n  initialState,\n  reducers: {\n    loadNotes: (state, action: PayloadAction<NoteItem[]>) => {\n      state.notes = action.payload\n      state.loading = false\n    },\n    loadNotesError: (state, action: PayloadAction<string>) => {\n      state.error = action.payload\n      state.loading = false\n    },\n    addNote: (state, action: PayloadAction<NoteItem>) => {\n      state.notes = [action.payload, ...state.notes]\n    },\n    updateNote: (state, action: PayloadAction<NoteItem>) => {\n      state.notes = state.notes.map((note) =>\n        note.id === action.payload.id ? action.payload : note\n      )\n    },\n    deleteNote: (state, action: PayloadAction<string>) => {\n      state.notes = state.notes.filter((note) => note.id !== action.payload)\n      state.selectedNotesIds = []\n    },\n    deleteNotes: (state, action: PayloadAction<string[]>) => {\n      state.notes = state.notes.filter((note) => !action.payload.includes(note.id))\n      state.selectedNotesIds = []\n    },\n    pruneNotes: (state) => {\n      state.notes = state.notes.filter((note) => note.text !== '' || note.scratchpad)\n    },\n    swapNote: (state, action: PayloadAction<string>) => {\n      state.activeNoteId = action.payload\n    },\n    updateActiveNote: (state, action: PayloadAction<{ noteId: string; multiSelect: boolean }>) => {\n      const { noteId, multiSelect } = action.payload\n      if (multiSelect) {\n        state.selectedNotesIds = state.selectedNotesIds.includes(noteId)\n          ? state.selectedNotesIds.filter((id) => id !== noteId)\n          : [...state.selectedNotesIds, noteId]\n      } else {\n        state.activeNoteId = noteId\n        state.selectedNotesIds = [noteId]\n      }\n    },\n    updateSelectedNotes: (\n      state,\n      action: PayloadAction<{ noteId: string; multiSelect: boolean }>\n    ) => {\n      const { noteId, multiSelect } = action.payload\n      if (multiSelect) {\n        state.selectedNotesIds = state.selectedNotesIds.includes(noteId)\n          ? state.selectedNotesIds.filter((id) => id !== noteId)\n          : [...state.selectedNotesIds, noteId]\n      } else {\n        state.selectedNotesIds = [noteId]\n      }\n    },\n    toggleFavoriteNote: (state, action: PayloadAction<string>) => {\n      state.notes = state.notes.map((note) =>\n        note.id === action.payload ? { ...note, favorite: !note.favorite } : note\n      )\n    },\n    toggleTrashedNote: (state, action: PayloadAction<string>) => {\n      state.notes = state.notes.map((note) =>\n        note.id === action.payload ? { ...note, trash: !note.trash } : note\n      )\n    },\n    permanentlyEmptyTrash: (state) => {\n      state.notes = state.notes.filter((note) => !note.trash)\n    },\n    restoreAllTrash: (state) => {\n      state.notes = state.notes.map((note) =>\n        note.trash ? { ...note, trash: false } : note\n      )\n    },\n    updateActiveFolder: (state, action: PayloadAction<Folder>) => {\n      state.activeFolder = action.payload\n      state.activeCategoryId = ''\n    },\n    updateActiveCategoryId: (state, action: PayloadAction<string>) => {\n      state.activeCategoryId = action.payload\n    },\n    searchNotes: (state, action: PayloadAction<string>) => {\n      state.searchValue = action.payload\n    },\n    resetSearchValue: (state) => {\n      state.searchValue = ''\n    },\n  },\n})\n\nexport const {\n  loadNotes,\n  loadNotesError,\n  addNote,\n  updateNote,\n  deleteNote,\n  deleteNotes,\n  pruneNotes,\n  swapNote,\n  updateActiveNote,\n  updateSelectedNotes,\n  toggleFavoriteNote,\n  toggleTrashedNote,\n  permanentlyEmptyTrash,\n  restoreAllTrash,\n  updateActiveFolder,\n  updateActiveCategoryId,\n  searchNotes,\n  resetSearchValue,\n} = noteSlice.actions\n\nexport default noteSlice.reducer\n"
    },
