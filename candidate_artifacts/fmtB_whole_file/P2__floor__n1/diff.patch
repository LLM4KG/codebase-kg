      "content": "import { createSlice, PayloadAction } from '@reduxjs/toolkit'\nimport { NoteItem, NoteState } from '@/types'\nimport { getRehydratedNotes } from '@/utils/rehydration'\n\nconst initialState: NoteState = getRehydratedNotes()\n\nconst noteSlice = createSlice({\n  name: 'note',\n  initialState,\n  reducers: {\n    addNote: (state, action: PayloadAction<NoteItem>) => {\n      state.notes = [action.payload, ...state.notes]\n    },\n    updateNote: (state, action: PayloadAction<NoteItem>) => {\n      state.notes = state.notes.map(note =>\n        note.id === action.payload.id ? action.payload : note\n      )\n    },\n    deleteNote: (state, action: PayloadAction<string>) => {\n      state.notes = state.notes.filter(note => note.id !== action.payload)\n    },\n    swapNote: (state, action: PayloadAction<string>) => {\n      state.activeNoteId = action.payload\n    },\n    swapCategory: (state, action: PayloadAction<string>) => {\n      state.activeCategoryId = action.payload\n    },\n    swapFolder: (state, action: PayloadAction<string>) => {\n      state.activeFolder = action.payload\n    },\n    toggleFavoriteNote: (state, action: PayloadAction<string>) => {\n      state.notes = state.notes.map(note =>\n        note.id === action.payload ? { ...note, favorite: !note.favorite } : note\n      )\n    },\n    toggleTrashedNote: (state, action: PayloadAction<string>) => {\n      state.notes = state.notes.map(note =>\n        note.id === action.payload ? { ...note, trash: !note.trash } : note\n      )\n    },\n    restoreAllTrash: state => {\n      state.notes = state.notes.map(note =>\n        note.trash ? { ...note, trash: false } : note\n      )\n    },\n    emptyTrash: state => {\n      state.notes = state.notes.filter(note => !note.trash)\n    },\n    updateActiveNote: (state, action: PayloadAction<string>) => {\n      state.activeNoteId = action.payload\n    },\n    loadNotes: (state, action: PayloadAction<NoteItem[]>) => {\n      state.notes = action.payload\n    },\n    pruneNotes: state => {\n      state.notes = state.notes.filter(note => note.text !== '')\n    },\n  },\n})\n\nexport const {\n  addNote,\n  updateNote,\n  deleteNote,\n  swapNote,\n  swapCategory,\n  swapFolder,\n  toggleFavoriteNote,\n  toggleTrashedNote,\n  restoreAllTrash,\n  emptyTrash,\n  updateActiveNote,\n  loadNotes,\n  pruneNotes,\n} = noteSlice.actions\n\nexport default noteSlice.reducer\n"
