      "content": "import React, { useState, useRef, useEffect } from 'react'\nimport { useDispatch, useSelector } from 'react-redux'\nimport { Folder, Plus, Trash2, RotateCcw } from 'react-feather'\n\nimport { TestID } from '@resources/TestID'\nimport { Folder as FolderEnum } from '@/utils/enums'\nimport { newNote } from '@/utils/helpers'\nimport {\n  addNote,\n  emptyTrash,\n  pruneNotes,\n  restoreAllTrash,\n  swapFolder,\n  swapNote,\n  toggleTrashedNote,\n  updateActiveNote,\n} from '@/slices/note'\nimport { NoteItem, ReactDragEvent, ReactMouseEvent, RootState } from '@/types'\nimport { getNoteTitle, sortByLastUpdated } from '@/utils/helpers'\nimport NoteOptions from '@/containers/NoteOptions'\n\nconst NoteList: React.FC = () => {\n  const dispatch = useDispatch()\n\n  const { notes, activeFolder, activeCategoryId, activeNoteId } = useSelector(\n    (state: RootState) => state.noteState\n  )\n\n  const { categories } = useSelector((state: RootState) => state.categoryState)\n\n  const [noteOptionsId, setNoteOptionsId] = useState('')\n  const [noteOptionsPosition, setNoteOptionsPosition] = useState({ x: 0, y: 0 })\n\n  const activeNote = notes.find(note => note.id === activeNoteId)\n\n  const re = /(\\d{4}-[01]\\d-[0-3]\\dT[0-2]\\d:[0-5]\\d:[0-5]\\d\\.\\d+([+-][0-2]\\d:[0-5]\\d|Z))|(\\d{4}-[01]\\d-[0-3]\\dT[0-2]\\d:[0-5]\\d:[0-5]\\d([+-][0-2]\\d:[0-5]\\d|Z))|(\\d{4}-[01]\\d-[0-3]\\dT[0-2]\\d:[0-5]\\d([+-][0-2]\\d:[0-5]\\d|Z))/\n\n  const filteredNotes: NoteItem[] = notes\n    .filter(note => {\n      if (activeFolder === FolderEnum.TRASH) {\n        return note.trash\n      } else if (activeFolder === FolderEnum.FAVORITES) {\n        return note.favorite && !note.trash\n      } else if (activeFolder === FolderEnum.SCRATCHPAD) {\n        return note.scratchpad\n      } else if (activeCategoryId) {\n        return note.categoryId === activeCategoryId && !note.trash && !note.scratchpad\n      } else {\n        return !note.trash && !note.categoryId && !note.scratchpad\n      }\n    })\n    .sort(sortByLastUpdated)\n\n  const notesSortedByCategory = notes.filter(note => !note.trash).sort(sortByLastUpdated)\n\n  const _addNote = () => {\n    const note = newNote(activeCategoryId, activeFolder)\n    dispatch(addNote(note))\n    dispatch(updateActiveNote(note.id))\n  }\n\n  const _emptyTrash = () => dispatch(emptyTrash())\n\n  const _restoreAllTrash = () => dispatch(restoreAllTrash())\n\n  const _swapNote = (noteId: string) => {\n    dispatch(pruneNotes())\n    dispatch(swapNote(noteId))\n  }\n\n  const _trashNote = (noteId: string) => dispatch(toggleTrashedNote(noteId))\n\n  const handleDragStart = (event: ReactDragEvent, noteId: string = '') => {\n    event.stopPropagation()\n    event.dataTransfer.setData('text/plain', noteId)\n  }\n\n  const handleNoteOptionsClick = (event: ReactMouseEvent, noteId: string = '') => {\n    const clicked = event.target as HTMLElement\n    setNoteOptionsPosition({ x: event.clientX, y: event.clientY })\n    setNoteOptionsId(noteId)\n  }\n\n  return (\n    <aside className=\"note-sidebar\">\n      <div className=\"note-sidebar-header\" data-testid={TestID.NOTE_SIDEBAR}>\n        {activeFolder === FolderEnum.TRASH ? (\n          <div className=\"note-options-div\">\n            <button\n              className=\"note-options-button\"\n              onClick={_restoreAllTrash}\n              data-testid={TestID.RESTORE_ALL_TRASH}\n            >\n              <RotateCcw size={15} />\n              Restore All\n            </button>\n            <button\n              className=\"note-options-button\"\n              onClick={_emptyTrash}\n              data-testid={TestID.EMPTY_TRASH}\n            >\n              <Trash2 size={15} />\n              Empty Trash\n            </button>\n          </div>\n        ) : (\n          <button\n            className=\"note-options-button\"\n            onClick={_addNote}\n            data-testid={TestID.ADD_NOTE}\n          >\n            <Plus size={15} />\n            Add Note\n          </button>\n        )}\n      </div>\n      <div className=\"note-list\" data-testid={TestID.NOTE_LIST}>\n        {filteredNotes.map(note => {\n          const noteTitle = getNoteTitle(note.text)\n          return (\n            <div\n              key={note.id}\n              className={`note-list-item${activeNoteId === note.id ? ' active' : ''}`}\n              onClick={() => _swapNote(note.id)}\n              draggable\n              onDragStart={event => handleDragStart(event, note.id)}\n              data-testid={TestID.NOTE_LIST_ITEM}\n            >\n              <div\n                className=\"note-title\"\n                data-testid={TestID.NOTE_TITLE}\n              >\n                {note.favorite && (\n                  <span role=\"img\" aria-label=\"Favorite\">\n                    \u2b50\n                  </span>\n                )}\n                {noteTitle}\n              </div>\n              <div\n                className=\"note-options\"\n                onClick={event => {\n                  event.stopPropagation()\n                  handleNoteOptionsClick(event, note.id)\n                }}\n                data-testid={TestID.NOTE_OPTIONS}\n              >\n                ...\n              </div>\n            </div>\n          )\n        })}\n      </div>\n      {noteOptionsId && (\n        <NoteOptions\n          noteId={noteOptionsId}\n          positionX={noteOptionsPosition.x}\n          positionY={noteOptionsPosition.y}\n          setNoteOptionsId={setNoteOptionsId}\n        />\n      )}\n    </aside>\n  )\n}\n\nexport default NoteList\n"
