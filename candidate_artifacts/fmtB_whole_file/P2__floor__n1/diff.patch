ote.id)}\n              data-testid={TestID.NOTE_LIST_ITEM}\n            >\n              <div className=\"note-title\" data-testid={TestID.NOTE_TITLE}>\n                {note.favorite && (\n                  <span role=\"img\" aria-label=\"Favorite\">\n                    \u2b50\n                  </span>\n                )}\n                {noteTitle}\n              </div>\n              <div\n                className=\"note-options\"\n                onClick={event => {\n                  event.stopPropagation()\n                  handleNoteOptionsClick(event, note.id)\n                }}\n                data-testid={TestID.NOTE_OPTIONS}\n              >\n                ...\n              </div>\n            </div>\n          )\n        })}\n      </div>\n      {noteOptionsId && (\n        <NoteOptions\n          noteId={noteOptionsId}\n          positionX={noteOptionsPosition.x}\n          positionY={noteOptionsPosition.y}\n          setNoteOptionsId={setNoteOptionsId}\n        />\n      )}\n    </aside>\n  )\n}\n\nexport default NoteList\n"
