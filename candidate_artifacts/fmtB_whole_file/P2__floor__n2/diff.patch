      "op": "write",
      "content": "import React, { useState, useRef, useEffect } from 'react'\nimport { useDispatch, useSelector } from 'react-redux'\nimport { Droppable } from 'react-beautiful-dnd'\nimport { MoreHorizontal, Trash, RefreshCw } from 'react-feather'\n\nimport NoteItem from '@/containers/NoteItem'\nimport { TestID } from '@/resources/TestID'\nimport { Folder } from '@/utils/enums'\nimport { getNoteTitle, sortByLastUpdated } from '@/utils/helpers'\nimport { emptyTrash, restoreAllTrash } from '@/slices/note'\nimport {\n  selectActiveCategoryId,\n  selectActiveFolder,\n  selectActiveNoteId,\n  selectNotes,\n} from '@/selectors'\n\nconst NoteList: React.FC = () => {\n  const dispatch = useDispatch()\n\n  const activeFolder = useSelector(selectActiveFolder)\n  const activeCategoryId = useSelector(selectActiveCategoryId)\n  const activeNoteId = useSelector(selectActiveNoteId)\n  const notes = useSelector(selectNotes)\n\n  const [noteOptionsId, setNoteOptionsId] = useState('')\n  const node = useRef<HTMLDivElement>(null)\n\n  const isTrash = activeFolder === Folder.TRASH\n\n  const filteredNotes: any[] = notes\n    .filter(note => {\n      if (activeFolder === Folder.FAVORITES) {\n        return !note.trash && note.favorite\n      } else if (activeFolder === Folder.TRASH) {\n        return note.trash\n      } else if (activeFolder === Folder.CATEGORY) {\n        return !note.trash && note.category === activeCategoryId\n      } else {\n        return !note.trash\n      }\n    })\n    .sort(sortByLastUpdated)\n\n  const handleDomClick = (event: MouseEvent) => {\n    const element = event.target as HTMLDivElement\n    if (node.current && node.current.contains(element)) return\n    setNoteOptionsId('')\n  }\n\n  useEffect(() => {\n    document.addEventListener('mousedown', handleDomClick)\n    return () => {\n      document.removeEventListener('mousedown', handleDomClick)\n    }\n  })\n\n  return (\n    <aside className=\"note-sidebar\">\n      <div className=\"note-sidebar-header\" data-testid={TestID.NOTE_SIDEBAR}>\n        {isTrash && (\n          <div className=\"trash-actions\">\n            <button\n              className=\"button-restore-all\"\n              data-testid={TestID.RESTORE_ALL_TRASH}\n              onClick={() => dispatch(restoreAllTrash())}\n            >\n              <RefreshCw size={14} className=\"button-icon\" />\n              Restore All\n            </button>\n            <button\n              className=\"button-empty-trash\"\n              data-testid={TestID.EMPTY_TRASH}\n              onClick={() => dispatch(emptyTrash())}\n            >\n              <Trash size={14} className=\"button-icon\" />\n              Empty Trash\n            </button>\n          </div>\n        )}\n      </div>\n      <Droppable droppableId=\"note-list\">\n        {provided => (\n          <div\n            {...provided.droppableProps}\n            ref={provided.innerRef}\n            className=\"note-list\"\n          >\n            {filteredNotes.map((note, index) => (\n              <NoteItem\n                key={note.id}\n                note={note}\n                index={index}\n                title={getNoteTitle(note.text)}\n                active={note.id === activeNoteId}\n                noteOptionsId={noteOptionsId}\n                setNoteOptionsId={setNoteOptionsId}\n              />\n            ))}\n            {provided.placeholder}\n          </div>\n        )}\n      </Droppable>\n    </aside>\n  )\n}\n\nexport default NoteList\n"
