      "content": "  const decreaseProductQuantity = (productId: string, quantity: number) => {\n    setCartProducts(prevCartProducts => {\n      return prevCartProducts.reduce((acc, cartProduct) => {\n        if (cartProduct.product.id === productId) {\n          const newQuantity = cartProduct.quantity - quantity;\n          if (newQuantity > 0) {\n            acc.push({\n              ...cartProduct,\n              quantity: newQuantity\n            });\n          }\n          // If newQuantity is <= 0, we simply don't add it back to the cart\n        } else {\n          acc.push(cartProduct);\n        }\n        return acc;\n      }, [] as CartProduct[]);\n    });\n  };\n"
