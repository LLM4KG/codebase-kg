diff --git a/src/client/utils/useCopyToClipboard.ts b/src/client/utils/useCopyToClipboard.ts
new file mode 100644
--- /dev/null
+++ b/src/client/utils/useCopyToClipboard.ts
@@ -0,0 +1,24 @@
+import { useState, useEffect } from 'react'
+
+const useCopyToClipboard = (
+  successMessage: string,
+  timeout: number = 3000
+): { copiedText: string; handleCopy: (text: string) => void } => {
+  const [copiedText, setCopiedText] = useState('')
+
+  useEffect(() => {
+    if (!copiedText) return
+    const timer = setTimeout(() => {
+      setCopiedText('')
+    }, timeout)
+    return () => clearTimeout(timer)
+  }, [copiedText, timeout])
+
+  const handleCopy = (text: string) => {
+    navigator.clipboard.writeText(text)
+    setCopiedText(successMessage)
+  }
+
+  return { copiedText, handleCopy }
+}
+
+export default useCopyToClipboard
